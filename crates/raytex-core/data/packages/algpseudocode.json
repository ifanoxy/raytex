{ "name": "algpseudocode", "description": { "en": "Pseudo-code layout (algorithmicx).", "fr": "Mise en forme de pseudo-code (algorithmicx)." },
  "commands": [
    { "name": "State", "mode": "text", "doc": { "en": "A statement.", "fr": "Une instruction." } },
    { "name": "If", "args": "{condition}", "doc": { "en": "If (closed by \\EndIf).", "fr": "Si (fermé par \\EndIf)." } },
    { "name": "ElsIf", "args": "{condition}", "doc": { "en": "Else if.", "fr": "Sinon si." } },
    { "name": "Else", "doc": { "en": "Else.", "fr": "Sinon." } },
    { "name": "EndIf", "doc": { "en": "End of if.", "fr": "Fin de si." } },
    { "name": "For", "args": "{condition}", "doc": { "en": "For loop (closed by \\EndFor).", "fr": "Boucle pour (fermée par \\EndFor)." } },
    { "name": "ForAll", "args": "{condition}", "doc": { "en": "For-all loop.", "fr": "Boucle pour tout." } },
    { "name": "EndFor", "doc": { "en": "End of for.", "fr": "Fin de pour." } },
    { "name": "While", "args": "{condition}", "doc": { "en": "While loop.", "fr": "Boucle tant que." } },
    { "name": "EndWhile", "doc": { "en": "End of while.", "fr": "Fin de tant que." } },
    { "name": "Repeat", "doc": { "en": "Repeat loop.", "fr": "Boucle répéter." } },
    { "name": "Until", "args": "{condition}", "doc": { "en": "Until.", "fr": "Jusqu'à." } },
    { "name": "Procedure", "args": "{name}{arguments}", "doc": { "en": "Procedure (closed by \\EndProcedure).", "fr": "Procédure (fermée par \\EndProcedure)." } },
    { "name": "EndProcedure", "doc": { "en": "End of procedure.", "fr": "Fin de procédure." } },
    { "name": "Function", "args": "{name}{arguments}", "doc": { "en": "Function (closed by \\EndFunction).", "fr": "Fonction (fermée par \\EndFunction)." } },
    { "name": "EndFunction", "doc": { "en": "End of function.", "fr": "Fin de fonction." } },
    { "name": "Require", "doc": { "en": "Precondition.", "fr": "Précondition." } },
    { "name": "Ensure", "doc": { "en": "Postcondition.", "fr": "Postcondition." } },
    { "name": "Return", "doc": { "en": "Return.", "fr": "Retourner." } },
    { "name": "Call", "args": "{name}{arguments}", "doc": { "en": "Procedure call.", "fr": "Appel de procédure." } },
    { "name": "Comment", "args": "{text}", "doc": { "en": "Comment on the right.", "fr": "Commentaire à droite." } } ],
  "environments": [ { "name": "algorithmic", "args": "[numbering]", "mode": "text", "doc": { "en": "Pseudo-code block; [1] numbers every line.", "fr": "Bloc de pseudo-code ; [1] numérote chaque ligne." } } ] }
