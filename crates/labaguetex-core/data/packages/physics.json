{ "name": "physics", "description": { "en": "Shortcuts for physics: derivatives, bra-ket, vectors, auto-sized brackets.", "fr": "Raccourcis pour la physique : dérivées, bra-ket, vecteurs, parenthèses auto-dimensionnées." }, "loads": ["amsmath", "xparse"],
  "commands": [
    { "name": "qty", "args": "(expr)", "mode": "math", "snippet": "qty(${1})", "doc": { "en": "Auto-sized brackets: \\qty(…), \\qty[…], \\qty{…}.", "fr": "Parenthèses auto-dimensionnées : \\qty(…), \\qty[…], \\qty{…}." } },
    { "name": "abs", "args": "{x}", "mode": "math", "doc": { "en": "Absolute value |x|.", "fr": "Valeur absolue |x|." } },
    { "name": "norm", "args": "{x}", "mode": "math", "doc": { "en": "Norm ‖x‖.", "fr": "Norme ‖x‖." } },
    { "name": "dv", "args": "[n]{f}{x}", "mode": "math", "doc": { "en": "Derivative df/dx.", "fr": "Dérivée df/dx." } },
    { "name": "pdv", "args": "[n]{f}{x}", "mode": "math", "doc": { "en": "Partial derivative ∂f/∂x.", "fr": "Dérivée partielle ∂f/∂x." } },
    { "name": "dd", "args": "{x}", "mode": "math", "doc": { "en": "Differential d x with spacing.", "fr": "Différentielle d x avec espacement." } },
    { "name": "bra", "args": "{ψ}", "mode": "math", "doc": { "en": "Bra ⟨ψ|.", "fr": "Bra ⟨ψ|." } },
    { "name": "ket", "args": "{ψ}", "mode": "math", "doc": { "en": "Ket |ψ⟩.", "fr": "Ket |ψ⟩." } },
    { "name": "braket", "args": "{a}{b}", "mode": "math", "doc": { "en": "Inner product ⟨a|b⟩.", "fr": "Produit scalaire ⟨a|b⟩." } },
    { "name": "expval", "args": "{A}", "mode": "math", "doc": { "en": "Expectation value ⟨A⟩.", "fr": "Valeur moyenne ⟨A⟩." } },
    { "name": "mel", "args": "{a}{A}{b}", "mode": "math", "doc": { "en": "Matrix element ⟨a|A|b⟩.", "fr": "Élément de matrice ⟨a|A|b⟩." } },
    { "name": "vb", "args": "{v}", "mode": "math", "doc": { "en": "Bold vector.", "fr": "Vecteur en gras." } },
    { "name": "vu", "args": "{v}", "mode": "math", "doc": { "en": "Unit vector (hat).", "fr": "Vecteur unitaire (chapeau)." } },
    { "name": "grad", "mode": "math", "doc": { "en": "Gradient ∇.", "fr": "Gradient ∇." } },
    { "name": "curl", "mode": "math", "doc": { "en": "Curl ∇×.", "fr": "Rotationnel ∇×." } },
    { "name": "laplacian", "mode": "math", "doc": { "en": "Laplacian ∇².", "fr": "Laplacien ∇²." } },
    { "name": "order", "args": "{x}", "mode": "math", "doc": { "en": "Big O: 𝒪(x).", "fr": "Grand O : 𝒪(x)." } },
    { "name": "mqty", "args": "{a & b \\\\ c & d}", "mode": "math", "doc": { "en": "Compact matrix.", "fr": "Matrice compacte." } },
    { "name": "eval", "args": "{expr}_{a}^{b}", "mode": "math", "doc": { "en": "Evaluation bar.", "fr": "Barre d'évaluation." } },
    { "name": "Tr", "mode": "math", "doc": { "en": "Trace.", "fr": "Trace." } },
    { "name": "rank", "mode": "math", "doc": { "en": "Rank.", "fr": "Rang." } } ] }
