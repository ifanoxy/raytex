{ "name": "exam", "class": true, "description": { "en": "Exams and exercise sheets with points, solutions and grading tables.", "fr": "Examens et feuilles d'exercices avec barème, corrigés et tableaux de notes." },
  "options": ["answers", "addpoints", "12pt", "a4paper"],
  "commands": [
    { "name": "question", "args": "[points]", "snippet": "question[${1:2}] ${2}", "doc": { "en": "A question, optionally with points.", "fr": "Une question, éventuellement avec des points." } },
    { "name": "part", "args": "[points]", "doc": { "en": "Part of a question (inside parts).", "fr": "Partie d'une question (dans parts)." } },
    { "name": "subpart", "args": "[points]", "doc": { "en": "Sub-part (inside subparts).", "fr": "Sous-partie (dans subparts)." } },
    { "name": "choice", "doc": { "en": "Wrong choice in a multiple-choice question.", "fr": "Choix incorrect dans un QCM." } },
    { "name": "CorrectChoice", "doc": { "en": "Correct choice (highlighted with answers).", "fr": "Choix correct (mis en évidence avec les réponses)." } },
    { "name": "printanswers", "mode": "preamble", "doc": { "en": "Shows solutions (answer key).", "fr": "Affiche les corrigés." } },
    { "name": "noprintanswers", "mode": "preamble", "doc": { "en": "Hides solutions.", "fr": "Masque les corrigés." } },
    { "name": "pointsinmargin", "mode": "preamble", "doc": { "en": "Points in the margin.", "fr": "Points dans la marge." } },
    { "name": "gradetable", "args": "[v|h][questions]", "mode": "text", "doc": { "en": "Grading table.", "fr": "Tableau de notation." } },
    { "name": "numpoints", "doc": { "en": "Total number of points.", "fr": "Nombre total de points." } },
    { "name": "header", "args": "{left}{centre}{right}", "doc": { "en": "Page header.", "fr": "En-tête de page." } },
    { "name": "footer", "args": "{left}{centre}{right}", "doc": { "en": "Page footer.", "fr": "Pied de page." } },
    { "name": "fillin", "args": "[answer][width]", "doc": { "en": "Blank to fill in.", "fr": "Espace à compléter." } },
    { "name": "bonusquestion", "args": "[points]", "doc": { "en": "Bonus question.", "fr": "Question bonus." } } ],
  "environments": [
    { "name": "questions", "mode": "text", "body": "\t\\question[${1:2}] ${2}", "doc": { "en": "List of questions.", "fr": "Liste de questions." } },
    { "name": "parts", "mode": "text", "body": "\t\\part ${1}", "doc": { "en": "Parts of a question.", "fr": "Parties d'une question." } },
    { "name": "subparts", "mode": "text", "doc": { "en": "Sub-parts.", "fr": "Sous-parties." } },
    { "name": "choices", "mode": "text", "body": "\t\\choice ${1}\n\t\\CorrectChoice ${2}", "doc": { "en": "Multiple choices (A, B, C…).", "fr": "Choix multiples (A, B, C…)." } },
    { "name": "checkboxes", "mode": "text", "doc": { "en": "Multiple choices with boxes.", "fr": "Choix multiples avec cases." } },
    { "name": "solution", "args": "[space]", "mode": "text", "doc": { "en": "Solution, shown with the answers option; otherwise leaves space.", "fr": "Corrigé, affiché avec l'option answers ; sinon laisse de la place." } } ] }
