{
  "name": "amsmath",
  "description": { "en": "The reference package for mathematics: alignments, matrices, fractions, operators.", "fr": "Le package de référence pour les mathématiques : alignements, matrices, fractions, opérateurs." },
  "loads": ["amstext", "amsbsy", "amsopn"],
  "options": ["fleqn", "leqno", "reqno", "centertags", "tbtags", "sumlimits", "nosumlimits", "intlimits", "nointlimits"],
  "commands": [
    { "name": "text", "args": "{text}", "mode": "math", "doc": { "en": "Normal text inside math.", "fr": "Texte normal dans des maths." }, "example": "x > 0 \\text{ pour tout } x" },
    { "name": "dfrac", "args": "{numerator}{denominator}", "mode": "math", "doc": { "en": "Display-size fraction.", "fr": "Fraction en taille « display »." } },
    { "name": "tfrac", "args": "{numerator}{denominator}", "mode": "math", "doc": { "en": "Text-size fraction.", "fr": "Fraction en taille texte." } },
    { "name": "cfrac", "args": "{numerator}{denominator}", "mode": "math", "doc": { "en": "Continued fraction.", "fr": "Fraction continue." } },
    { "name": "binom", "args": "{n}{k}", "mode": "math", "doc": { "en": "Binomial coefficient.", "fr": "Coefficient binomial." } },
    { "name": "dbinom", "args": "{n}{k}", "mode": "math", "doc": { "en": "Display-size binomial.", "fr": "Coefficient binomial en taille « display »." } },
    { "name": "tbinom", "args": "{n}{k}", "mode": "math", "doc": { "en": "Text-size binomial.", "fr": "Coefficient binomial en taille texte." } },
    { "name": "genfrac", "args": "{left}{right}{thickness}{style}{num}{den}", "mode": "math", "doc": { "en": "Generalised fraction.", "fr": "Fraction généralisée." } },
    { "name": "operatorname", "args": "{name}", "mode": "math", "doc": { "en": "Upright operator name with correct spacing: \\operatorname{Vect}.", "fr": "Nom d'opérateur droit avec espacement correct : \\operatorname{Vect}." } },
    { "name": "DeclareMathOperator", "args": "{\\name}{text}", "mode": "preamble", "snippet": "DeclareMathOperator{\\${1:name}}{${2:text}}", "doc": { "en": "Declares an operator such as \\rg; the starred form puts limits below.", "fr": "Déclare un opérateur comme \\rg ; la forme étoilée place les bornes dessous." } },
    { "name": "eqref", "args": "{key}", "doc": { "en": "Reference to an equation, in parentheses: (1.2).", "fr": "Référence à une équation, entre parenthèses : (1.2)." } },
    { "name": "tag", "args": "{label}", "mode": "math", "doc": { "en": "Custom equation tag.", "fr": "Numéro d'équation personnalisé." } },
    { "name": "notag", "mode": "math", "doc": { "en": "Suppresses the number of the current line.", "fr": "Supprime le numéro de la ligne courante." } },
    { "name": "nonumber", "mode": "math", "doc": { "en": "Suppresses the number of the current line.", "fr": "Supprime le numéro de la ligne courante." } },
    { "name": "intertext", "args": "{text}", "mode": "math", "doc": { "en": "Text between the lines of an alignment, keeping the alignment.", "fr": "Texte entre les lignes d'un alignement, qui reste aligné." } },
    { "name": "iint", "mode": "math", "glyph": "∬", "category": "large-operator", "doc": { "en": "Double integral.", "fr": "Intégrale double." } },
    { "name": "iiint", "mode": "math", "glyph": "∭", "category": "large-operator", "doc": { "en": "Triple integral.", "fr": "Intégrale triple." } },
    { "name": "iiiint", "mode": "math", "glyph": "⨌", "category": "large-operator", "doc": { "en": "Quadruple integral.", "fr": "Intégrale quadruple." } },
    { "name": "idotsint", "mode": "math", "doc": { "en": "Multiple integral with dots.", "fr": "Intégrale multiple avec points." } },
    { "name": "overset", "args": "{top}{symbol}", "mode": "math", "doc": { "en": "Puts a symbol over another: \\overset{\\text{def}}{=}.", "fr": "Place un symbole au-dessus d'un autre : \\overset{\\text{déf}}{=}." } },
    { "name": "underset", "args": "{bottom}{symbol}", "mode": "math", "doc": { "en": "Puts a symbol under another.", "fr": "Place un symbole sous un autre." } },
    { "name": "xrightarrow", "args": "[below]{above}", "mode": "math", "doc": { "en": "Extensible right arrow with text above.", "fr": "Flèche droite extensible avec texte au-dessus." } },
    { "name": "xleftarrow", "args": "[below]{above}", "mode": "math", "doc": { "en": "Extensible left arrow with text above.", "fr": "Flèche gauche extensible avec texte au-dessus." } },
    { "name": "boldsymbol", "args": "{symbol}", "mode": "math", "doc": { "en": "Bold math symbol (including Greek letters).", "fr": "Symbole mathématique gras (y compris les lettres grecques)." } },
    { "name": "pmb", "args": "{symbol}", "mode": "math", "doc": { "en": "Poor man's bold.", "fr": "Gras simulé." } },
    { "name": "substack", "args": "{lines}", "mode": "math", "doc": { "en": "Several lines under a sum: \\sum_{\\substack{i<n\\\\ j<m}}.", "fr": "Plusieurs lignes sous une somme : \\sum_{\\substack{i<n\\\\ j<m}}." } },
    { "name": "sideset", "args": "{before}{after}", "mode": "math", "doc": { "en": "Adds sub/superscripts on the sides of a large operator.", "fr": "Ajoute indices/exposants sur les côtés d'un grand opérateur." } },
    { "name": "numberwithin", "args": "{counter}{parent}", "mode": "preamble", "doc": { "en": "Numbers equations within sections: \\numberwithin{equation}{section}.", "fr": "Numérote les équations par section : \\numberwithin{equation}{section}." } },
    { "name": "allowdisplaybreaks", "args": "[level]", "mode": "preamble", "doc": { "en": "Allows page breaks inside multi-line equations.", "fr": "Autorise les sauts de page dans les équations multi-lignes." } },
    { "name": "lvert", "mode": "math", "glyph": "|", "category": "delimiter", "doc": { "en": "Left vertical bar (absolute value).", "fr": "Barre verticale gauche (valeur absolue)." } },
    { "name": "rvert", "mode": "math", "glyph": "|", "category": "delimiter", "doc": { "en": "Right vertical bar.", "fr": "Barre verticale droite." } },
    { "name": "lVert", "mode": "math", "glyph": "‖", "category": "delimiter", "doc": { "en": "Left double bar (norm).", "fr": "Double barre gauche (norme)." } },
    { "name": "rVert", "mode": "math", "glyph": "‖", "category": "delimiter", "doc": { "en": "Right double bar.", "fr": "Double barre droite." } },
    { "name": "dotsc", "mode": "math", "doc": { "en": "Dots between commas.", "fr": "Points entre virgules." } },
    { "name": "dotsb", "mode": "math", "doc": { "en": "Dots between binary operators.", "fr": "Points entre opérateurs binaires." } },
    { "name": "dotsm", "mode": "math", "doc": { "en": "Dots for multiplication.", "fr": "Points pour une multiplication." } },
    { "name": "dotsi", "mode": "math", "doc": { "en": "Dots between integrals.", "fr": "Points entre intégrales." } },
    { "name": "smash", "args": "[tb]{content}", "mode": "any", "doc": { "en": "Ignores the height/depth of its content.", "fr": "Ignore la hauteur/profondeur de son contenu." } },
    { "name": "implies", "mode": "math", "glyph": "⟹", "doc": { "en": "Implication arrow with spacing.", "fr": "Flèche d'implication avec espacement." } },
    { "name": "iff", "mode": "math", "glyph": "⟺", "doc": { "en": "Equivalence arrow with spacing.", "fr": "Flèche d'équivalence avec espacement." } }
  ],
  "environments": [
    { "name": "equation*", "math": true, "mode": "text", "body": "\t${1}", "doc": { "en": "Unnumbered display equation.", "fr": "Équation centrée non numérotée." } },
    { "name": "align", "math": true, "mode": "text", "body": "\t${1} &= ${2} \\\\\n\t${3} &= ${4}", "doc": { "en": "Aligned equations, numbered. & marks the alignment point, \\\\ ends a line.", "fr": "Équations alignées et numérotées. & marque le point d'alignement, \\\\ termine une ligne." }, "example": "\\begin{align}\n  f(x) &= (x+1)^2 \\\\\n       &= x^2 + 2x + 1\n\\end{align}" },
    { "name": "align*", "math": true, "mode": "text", "body": "\t${1} &= ${2} \\\\\n\t${3} &= ${4}", "doc": { "en": "Aligned equations, unnumbered.", "fr": "Équations alignées, non numérotées." } },
    { "name": "gather", "math": true, "mode": "text", "doc": { "en": "Several centred equations, numbered.", "fr": "Plusieurs équations centrées, numérotées." } },
    { "name": "gather*", "math": true, "mode": "text", "doc": { "en": "Several centred equations, unnumbered.", "fr": "Plusieurs équations centrées, non numérotées." } },
    { "name": "multline", "math": true, "mode": "text", "doc": { "en": "One long equation split over several lines.", "fr": "Une longue équation répartie sur plusieurs lignes." } },
    { "name": "multline*", "math": true, "mode": "text", "doc": { "en": "Unnumbered multline.", "fr": "multline non numéroté." } },
    { "name": "flalign", "math": true, "mode": "text", "doc": { "en": "Alignment using the full line width.", "fr": "Alignement sur toute la largeur de la ligne." } },
    { "name": "flalign*", "math": true, "mode": "text", "doc": { "en": "Unnumbered flalign.", "fr": "flalign non numéroté." } },
    { "name": "alignat", "args": "{columns}", "math": true, "mode": "text", "doc": { "en": "Alignment with several columns and no added space.", "fr": "Alignement sur plusieurs colonnes sans espace ajoutée." } },
    { "name": "alignat*", "args": "{columns}", "math": true, "mode": "text", "doc": { "en": "Unnumbered alignat.", "fr": "alignat non numéroté." } },
    { "name": "split", "mode": "math", "doc": { "en": "Splits one equation over several aligned lines, with a single number (inside equation).", "fr": "Coupe une équation sur plusieurs lignes alignées, avec un seul numéro (dans equation)." } },
    { "name": "aligned", "mode": "math", "doc": { "en": "Aligned block inside another math environment.", "fr": "Bloc aligné à l'intérieur d'un autre environnement mathématique." } },
    { "name": "gathered", "mode": "math", "doc": { "en": "Centred block inside another math environment.", "fr": "Bloc centré à l'intérieur d'un autre environnement mathématique." } },
    { "name": "cases", "mode": "math", "body": "\t${1} & \\text{si } ${2} \\\\\n\t${3} & \\text{sinon}", "doc": { "en": "Definition by cases, with a left brace.", "fr": "Définition par cas, avec une accolade gauche." }, "example": "|x| = \\begin{cases} x & \\text{si } x \\ge 0 \\\\ -x & \\text{sinon} \\end{cases}" },
    { "name": "matrix", "mode": "math", "doc": { "en": "Matrix without delimiters.", "fr": "Matrice sans délimiteurs." } },
    { "name": "pmatrix", "mode": "math", "body": "\t${1:a} & ${2:b} \\\\\n\t${3:c} & ${4:d}", "doc": { "en": "Matrix in parentheses.", "fr": "Matrice entre parenthèses." } },
    { "name": "bmatrix", "mode": "math", "doc": { "en": "Matrix in square brackets.", "fr": "Matrice entre crochets." } },
    { "name": "Bmatrix", "mode": "math", "doc": { "en": "Matrix in braces.", "fr": "Matrice entre accolades." } },
    { "name": "vmatrix", "mode": "math", "doc": { "en": "Determinant (vertical bars).", "fr": "Déterminant (barres verticales)." } },
    { "name": "Vmatrix", "mode": "math", "doc": { "en": "Matrix in double bars (norm).", "fr": "Matrice entre doubles barres (norme)." } },
    { "name": "smallmatrix", "mode": "math", "doc": { "en": "Small inline matrix.", "fr": "Petite matrice en ligne." } },
    { "name": "subequations", "mode": "text", "doc": { "en": "Numbers the enclosed equations 1a, 1b…", "fr": "Numérote les équations incluses 1a, 1b…" } }
  ]
}
