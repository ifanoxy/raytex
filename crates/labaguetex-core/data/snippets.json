[
  { "trigger": "doc", "name": { "en": "Minimal document", "fr": "Document minimal" }, "body": "\\documentclass[11pt,a4paper]{${1:article}}\n\\usepackage[T1]{fontenc}\n\\usepackage[${2:french}]{babel}\n\n\\title{${3:Titre}}\n\\author{${4:Auteur}}\n\n\\begin{document}\n\\maketitle\n\n${5}\n\n\\end{document}" },
  { "trigger": "fig", "name": { "en": "Figure with image", "fr": "Figure avec image" }, "body": "\\begin{figure}[${1:htbp}]\n\t\\centering\n\t\\includegraphics[width=${2:0.8}\\linewidth]{${3:file}}\n\t\\caption{${4:Caption}}\n\t\\label{fig:${5:label}}\n\\end{figure}", "package": "graphicx" },
  { "trigger": "subfig", "name": { "en": "Two sub-figures side by side", "fr": "Deux sous-figures côte à côte" }, "body": "\\begin{figure}[${1:htbp}]\n\t\\centering\n\t\\begin{subfigure}{0.48\\linewidth}\n\t\t\\includegraphics[width=\\linewidth]{${2:a}}\n\t\t\\caption{${3}}\n\t\\end{subfigure}\\hfill\n\t\\begin{subfigure}{0.48\\linewidth}\n\t\t\\includegraphics[width=\\linewidth]{${4:b}}\n\t\t\\caption{${5}}\n\t\\end{subfigure}\n\t\\caption{${6:Caption}}\n\t\\label{fig:${7:label}}\n\\end{figure}", "package": "subcaption" },
  { "trigger": "tab", "name": { "en": "Table (booktabs)", "fr": "Tableau (booktabs)" }, "body": "\\begin{table}[${1:htbp}]\n\t\\centering\n\t\\caption{${2:Caption}}\n\t\\label{tab:${3:label}}\n\t\\begin{tabular}{${4:lcc}}\n\t\t\\toprule\n\t\t${5:A} & ${6:B} & ${7:C} \\\\\n\t\t\\midrule\n\t\t${8} &  &  \\\\\n\t\t\\bottomrule\n\t\\end{tabular}\n\\end{table}", "package": "booktabs" },
  { "trigger": "tabular", "name": { "en": "Simple tabular", "fr": "Tableau simple" }, "body": "\\begin{tabular}{${1:|l|c|r|}}\n\t\\hline\n\t${2} &  &  \\\\\n\t\\hline\n\\end{tabular}" },
  { "trigger": "item", "name": { "en": "Bulleted list", "fr": "Liste à puces" }, "body": "\\begin{itemize}\n\t\\item ${1}\n\t\\item ${2}\n\\end{itemize}" },
  { "trigger": "enum", "name": { "en": "Numbered list", "fr": "Liste numérotée" }, "body": "\\begin{enumerate}\n\t\\item ${1}\n\t\\item ${2}\n\\end{enumerate}" },
  { "trigger": "desc", "name": { "en": "Description list", "fr": "Liste de descriptions" }, "body": "\\begin{description}\n\t\\item[${1:Terme}] ${2:Définition}\n\\end{description}" },
  { "trigger": "eq", "name": { "en": "Numbered equation", "fr": "Équation numérotée" }, "body": "\\begin{equation}\n\t${1}\n\t\\label{eq:${2:label}}\n\\end{equation}" },
  { "trigger": "eq*", "name": { "en": "Unnumbered equation", "fr": "Équation non numérotée" }, "body": "\\[\n\t${1}\n\\]" },
  { "trigger": "ali", "name": { "en": "Aligned equations", "fr": "Équations alignées" }, "body": "\\begin{align}\n\t${1} &= ${2} \\\\\n\t${3} &= ${4}\n\\end{align}", "package": "amsmath" },
  { "trigger": "cases", "name": { "en": "Definition by cases", "fr": "Définition par cas" }, "body": "\\begin{cases}\n\t${1} & \\text{si } ${2} \\\\\n\t${3} & \\text{sinon}\n\\end{cases}", "package": "amsmath" },
  { "trigger": "mat", "name": { "en": "Matrix (pmatrix)", "fr": "Matrice (pmatrix)" }, "body": "\\begin{pmatrix}\n\t${1:a} & ${2:b} \\\\\n\t${3:c} & ${4:d}\n\\end{pmatrix}", "package": "amsmath", "math": true },
  { "trigger": "frac", "name": { "en": "Fraction", "fr": "Fraction" }, "body": "\\frac{${1}}{${2}}", "math": true },
  { "trigger": "sum", "name": { "en": "Sum with limits", "fr": "Somme avec bornes" }, "body": "\\sum_{${1:i=1}}^{${2:n}} ${3}", "math": true },
  { "trigger": "int", "name": { "en": "Integral", "fr": "Intégrale" }, "body": "\\int_{${1:a}}^{${2:b}} ${3:f(x)} \\,\\mathrm{d}${4:x}", "math": true },
  { "trigger": "lim", "name": { "en": "Limit", "fr": "Limite" }, "body": "\\lim_{${1:x} \\to ${2:\\infty}} ${3}", "math": true },
  { "trigger": "set", "name": { "en": "Set-builder notation", "fr": "Ensemble en compréhension" }, "body": "\\left\\\\{ ${1:x} \\mid ${2} \\right\\\\}", "math": true },
  { "trigger": "norm", "name": { "en": "Norm", "fr": "Norme" }, "body": "\\left\\lVert ${1} \\right\\rVert", "math": true, "package": "amsmath" },
  { "trigger": "abs", "name": { "en": "Absolute value", "fr": "Valeur absolue" }, "body": "\\left\\lvert ${1} \\right\\rvert", "math": true, "package": "amsmath" },
  { "trigger": "thm", "name": { "en": "Theorem", "fr": "Théorème" }, "body": "\\begin{theorem}[${1:Nom}]\n\t\\label{thm:${2:label}}\n\t${3}\n\\end{theorem}" },
  { "trigger": "proof", "name": { "en": "Proof", "fr": "Démonstration" }, "body": "\\begin{proof}\n\t${1}\n\\end{proof}", "package": "amsthm" },
  { "trigger": "defn", "name": { "en": "Definition", "fr": "Définition" }, "body": "\\begin{definition}\n\t${1}\n\\end{definition}" },
  { "trigger": "sec", "name": { "en": "Section with label", "fr": "Section avec label" }, "body": "\\section{${1:Titre}}\n\\label{sec:${2:label}}\n\n${3}" },
  { "trigger": "ssec", "name": { "en": "Subsection with label", "fr": "Sous-section avec label" }, "body": "\\subsection{${1:Titre}}\n\\label{sec:${2:label}}\n\n${3}" },
  { "trigger": "chap", "name": { "en": "Chapter with label", "fr": "Chapitre avec label" }, "body": "\\chapter{${1:Titre}}\n\\label{ch:${2:label}}\n\n${3}" },
  { "trigger": "frame", "name": { "en": "Beamer slide", "fr": "Diapositive beamer" }, "body": "\\begin{frame}{${1:Titre}}\n\t\\begin{itemize}\n\t\t\\item ${2}\n\t\\end{itemize}\n\\end{frame}" },
  { "trigger": "cols", "name": { "en": "Beamer columns", "fr": "Colonnes beamer" }, "body": "\\begin{columns}\n\t\\begin{column}{0.5\\textwidth}\n\t\t${1}\n\t\\end{column}\n\t\\begin{column}{0.5\\textwidth}\n\t\t${2}\n\t\\end{column}\n\\end{columns}" },
  { "trigger": "tikz", "name": { "en": "TikZ picture", "fr": "Dessin TikZ" }, "body": "\\begin{tikzpicture}\n\t\\draw[${1:thick}] (${2:0,0}) -- (${3:2,1});\n\\end{tikzpicture}", "package": "tikz" },
  { "trigger": "plot", "name": { "en": "Function plot (pgfplots)", "fr": "Tracé de fonction (pgfplots)" }, "body": "\\begin{tikzpicture}\n\t\\begin{axis}[xlabel={$x$}, ylabel={$y$}, grid=major]\n\t\t\\addplot[${1:blue}, domain=${2:-2:2}, samples=100] {${3:x^2}};\n\t\\end{axis}\n\\end{tikzpicture}", "package": "pgfplots" },
  { "trigger": "code", "name": { "en": "Code listing", "fr": "Listing de code" }, "body": "\\begin{lstlisting}[language=${1:Python}, caption={${2:Code}}]\n${3}\n\\end{lstlisting}", "package": "listings" },
  { "trigger": "minipage", "name": { "en": "Two minipages", "fr": "Deux minipages" }, "body": "\\begin{minipage}{0.48\\linewidth}\n\t${1}\n\\end{minipage}\\hfill\n\\begin{minipage}{0.48\\linewidth}\n\t${2}\n\\end{minipage}" },
  { "trigger": "href", "name": { "en": "Hyperlink", "fr": "Lien hypertexte" }, "body": "\\href{${1:https://}}{${2:texte}}", "package": "hyperref" },
  { "trigger": "cite", "name": { "en": "Citation", "fr": "Citation" }, "body": "\\cite{${1}}" },
  { "trigger": "fn", "name": { "en": "Footnote", "fr": "Note de bas de page" }, "body": "\\footnote{${1}}" },
  { "trigger": "bold", "name": { "en": "Bold (wraps selection)", "fr": "Gras (entoure la sélection)" }, "body": "\\textbf{${1:${SELECTION}}}" },
  { "trigger": "ital", "name": { "en": "Emphasis (wraps selection)", "fr": "Mise en évidence (entoure la sélection)" }, "body": "\\emph{${1:${SELECTION}}}" },
  { "trigger": "bib", "name": { "en": "Bibliography (biblatex)", "fr": "Bibliographie (biblatex)" }, "body": "\\printbibliography", "package": "biblatex" },
  { "trigger": "si", "name": { "en": "Quantity with unit", "fr": "Grandeur avec unité" }, "body": "\\qty{${1:9.81}}{${2:\\metre\\per\\second\\squared}}", "package": "siunitx" },
  { "trigger": "ce", "name": { "en": "Chemical formula", "fr": "Formule chimique" }, "body": "\\ce{${1:H2O}}", "package": "mhchem" },
  { "trigger": "algo", "name": { "en": "Algorithm (algpseudocode)", "fr": "Algorithme (algpseudocode)" }, "body": "\\begin{algorithm}\n\t\\caption{${1:Nom}}\n\t\\begin{algorithmic}[1]\n\t\t\\Require ${2}\n\t\t\\State ${3}\n\t\t\\Return ${4}\n\t\\end{algorithmic}\n\\end{algorithm}", "package": "algpseudocode" },
  { "trigger": "exo", "name": { "en": "Exercise with solution (exam)", "fr": "Exercice avec corrigé (exam)" }, "body": "\\question[${1:2}] ${2:Énoncé}\n\\begin{solution}\n\t${3:Corrigé}\n\\end{solution}" }
]
